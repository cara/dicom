{
  "name": "dicom-cine-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Browserbasierter DICOM-Viewer mit Cine-Wiedergabe und Video-Export (MP4). Alle Daten bleiben lokal.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev",
    "test": "node --test test/*.test.mjs",
    "serve": "node scripts/serve.mjs dist"
  },
  "dependencies": {
    "@cornerstonejs/codec-charls": "1.2.7",
    "@cornerstonejs/codec-openjpeg": "1.3.6",
    "dicom-parser": "1.8.21",
    "fflate": "0.8.3",
    "jpeg-lossless-decoder-js": "2.1.2",
    "mp4-muxer": "5.2.2"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  },
  "engines": {
    "node": ">=18"
  }
}
